{
  "name": "pw-artillery",
  "version": "1.0.0",
  "description": "Playwright test suite with TypeScript",
  "scripts": {
    "func:test:report:cloud": "npx playwright test --project=chromium",
    "func:test:headed": "npx playwright test --project=chromium --headed",
    "func:test:ui": "npx playwright test --project=chromium --ui",
    "func:report": "npx playwright test --project=chromium && npx playwright show-report",
    "arty:load:test": "npx artillery run ./tests/load/homePage.load.spec.ts",
    "arty:load:report": "dotenv -- artillery run ./tests/load/homePage.load.spec.ts --record",
    "arty:perf:test": "npx artillery run ./tests/perf/homePage.perf.spec.ts",
    "arty:perf:report": "dotenv -- artillery run ./tests/perf/homePage.perf.spec.ts --record",
    "func:report:then:arty:load:report": "npm run func:test:report:cloud && npm run arty:load:report"
  },
  "devDependencies": {
    "@artilleryio/playwright-reporter": "^1.1.3",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "artillery": "^2.0.30",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
