{
  "name": "pw-artillery",
  "version": "1.0.0",
  "description": "Playwright test suite with TypeScript",
  "scripts": {
    "test:cloud": "npx playwright test --project=chromium",
    "test:headed": "npx playwright test --project=chromium --headed",
    "test:ui": "npx playwright test --project=chromium --ui",
    "report": "npx playwright test --project=chromium && npx playwright show-report",
    "artillery:load": "npx artillery run ./tests/load/homePage.load.spec.ts",
    "artillery:load:report": "dotenv -- artillery run ./tests/load/homePage.load.spec.ts --record",
    "artillery:perf": "npx artillery run ./tests/load/homePage.perf.spec.ts",
    "artillery:perf:report": "dotenv -- artillery run ./tests/load/homePage.perf.spec.ts --record"
  },
  "devDependencies": {
    "@artilleryio/playwright-reporter": "^1.1.3",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "artillery": "^2.0.30",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^17.3.1"
  }
}
